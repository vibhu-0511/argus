{
  "name": "@argus/dom2src-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite plugin that stamps data-src on JSX host elements in dev and test.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test test/transform.test.ts",
    "test:attribute": "node --require ./test/installed-browser.cjs ./node_modules/@playwright/test/cli.js test",
    "fixture:dev": "vite --config fixture/vite.config.ts --host 127.0.0.1 --port 5191 --strictPort --mode development",
    "fixture:prod": "node fixture/preview-prod.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  }
}
