+.radar-list { display: flex; flex-direction: column; max-height: 540px; overflow-y: auto; padding-right: 4px; border-top: 1px solid var(--radar-line); }
 .radar-list::-webkit-scrollbar { width: 8px; }
 .radar-list::-webkit-scrollbar-thumb { background: rgba(59, 130, 246, 0.25); border-radius: 4px; }
