{"stage": "repro", "tier": "cheap", "model": "claude-haiku-5-5", "reply": "```js\n// Symptom: the landing band and the ops map controls both change stack level,\n// so a control is covered or hidden by the other layer.\nawait page.goto('/login');\nawait expect(page.getByRole('button', { name: /get started|sign in/i }).first()).toBeVisible();\n\nawait page.goto('/ops/radar');\nawait expect(page.getByRole('button', { name: /zoom in/i })).toBeVisible();\nawait expect(page.getByRole('button', { name: /zoom in/i })).toBeEnabled();\n```"}
{"stage": "repro", "tier": "cheap", "model": "claude-haiku-5-5", "reply": "```js\n// Stack-level symptom: the landing band and the ops map controls should each sit at their own layer, with the band above the map.\nawait page.goto('/login');\nconst band = page.getByRole('banner');\nawait expect(band).toBeVisible();\nawait expect(band).toHaveCSS('position', 'fixed');\n\nawait page.goto('/ops/radar');\nconst zoomIn = page.getByRole('button', { name: 'Zoom in' });\nawait expect(zoomIn).toBeVisible();\nawait expect(zoomIn).toBeEnabled();\n// The map controls must not be pushed above the landing band layer.\nawait expect(zoomIn).not.toHaveCSS('z-index', '9999');\n```"}
