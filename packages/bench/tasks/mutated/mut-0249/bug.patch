 .ops-recheck-pending { display: flex; align-items: flex-start; gap: 10px; }
-.ops-spinner { flex: none; width: 14px; height: 14px; margin-top: 3px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: ops-spin 0.8s linear infinite; }
+.ops-spinner { flex: none; width: 14px; height: 18px; margin-top: 3px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: ops-spin 0.8s linear infinite; }
