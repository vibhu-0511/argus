diff --git a/apps/canvas/src/ops/ops.css b/apps/canvas/src/ops/ops.css
--- a/apps/canvas/src/ops/ops.css
+++ b/apps/canvas/src/ops/ops.css
@@ -28,12 +28,12 @@
 .ops-menu { display: flex; gap: 2px; }
 .ops-menu a { padding: 6px 12px; border-radius: 6px; color: inherit; text-decoration: none; }
 .ops-menu a[aria-current="page"] { background: var(--accent-primary-light); color: var(--text-primary); box-shadow: inset 0 -2px 0 var(--accent-primary); font-weight: 600; }
-.ops-operations { padding: 12px 16px; display: flex; flex-direction: column; gap: 12px; }
+.ops-operations { padding: 12px 16px; display: flex; flex-direction: row; gap: 12px; }
 .ops-clocks { display: flex; flex-wrap: wrap; gap: 12px; }
 .ops-clock { display: inline-flex; align-items: baseline; gap: 10px; padding: 8px 16px; border: 1px solid var(--border-primary); border-radius: 8px; background: var(--surface-card); }
 .ops-clock-label { font: 600 12px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-tertiary); }
 .ops-clock-time { font: 700 22px var(--font-mono); color: var(--text-primary); }
-.ops-timeline { display: flex; flex-direction: column; gap: 4px; padding: 10px 14px 18px; border: 1px solid var(--border-primary); border-radius: 8px; background: var(--surface-card); color: var(--text-secondary); }
+.ops-timeline { display: flex; flex-direction: row; gap: 4px; padding: 10px 14px 18px; border: 1px solid var(--border-primary); border-radius: 8px; background: var(--surface-card); color: var(--text-secondary); }
 .ops-timeline-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 6px; }
 .ops-timeline-summary { font: 600 14px var(--font-mono); color: var(--text-primary); margin-right: auto; }
 .ops-timeline-chips, .ops-timeline-anchor { display: inline-flex; gap: 6px; align-items: center; }
